
# Editor / agent local dirs
.coder/
.opencode/
.idea/
# .claude/ is local except the shared worktree guard (docs/CHANGE-WORKFLOW.md).
# Needs the glob form: git cannot re-include a path under an excluded directory.
.claude/*
!.claude/settings.json
!.claude/hooks/
/taskmgr-ui
coverage.out
coverage-*.out
dist/
/load-test-report.json
__pycache__/
*.pyc

# Temp/agent extraction dirs (must never be committed)
.tmp-*/

# Local dev task tracker — kept local, not published.
# No trailing slash: in a worktree these are symlinks to the main checkout, and a
# directory-only pattern would leave them untracked-but-visible in git status.
.tasks

# Local, non-shared working notes
hako-private
