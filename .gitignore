
# Editor / agent local dirs
.coder/
.opencode/
.idea/
# .claude/ is local except the shared worktree config and guard. Glob form, because
# git cannot re-include a path under an excluded directory.
.claude/*
!.claude/settings.json
!.claude/hooks/
/taskmgr-ui
coverage.out
coverage-*.out
dist/
/load-test-report.json
__pycache__/
*.pyc

# Temp/agent extraction dirs (must never be committed)
.tmp-*/

# Local dev task tracker. The store is central (~/.taskmgr); this guards a
# .tasks re-created here by a stray `taskmgr init`, which must never be published.
.tasks

# Local, non-shared working notes
hako-private
