
# Editor / agent local dirs
.coder/
.opencode/
.idea/
# .claude/ is local except the shared worktree config and guard. Glob form, because
# git cannot re-include a path under an excluded directory.
.claude/*
!.claude/settings.json
!.claude/hooks/
/taskmgr-ui
coverage.out
coverage-*.out
dist/
/load-test-report.json
__pycache__/
*.pyc

# Temp/agent extraction dirs (must never be committed)
.tmp-*/

# Local dev task tracker — kept local, not published. No trailing slash: inside a
# worktree these are symlinks, which a directory-only pattern would not match.
.tasks

# Local, non-shared working notes
hako-private
